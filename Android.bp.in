cc_prebuilt_library_shared {
    name: "FloralFaceIDAutocalSolvers",
    owner: "google",
    stem: "libautocalsolvers",
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/lib64/libautocalsolvers.so",
            ],
            shared_libs: [
                "libm",
                "liblog",
                "libz",
                "libdl",
                "libc",
            ],
        },
    },
    compile_multilib: "64",
    // The verified stock blob has SONAME libautocalsolvers.so-Wl.
    // HAL dlopen requires the stock filename libautocalsolvers.so.
    check_elf_files: false,
    strip: {
        none: true,
    },
    prefer: true,
    soc_specific: true,
}

