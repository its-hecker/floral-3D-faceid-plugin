    name: "FloralFaceIDV33Base",
    stem: "libbase-v33",
    vendor: true,
    compile_multilib: "64",
    srcs: ["proprietary/compat/libbase-v33.so"],
    shared_libs: ["libc++", "liblog"],
    strip: { none: true },
}

