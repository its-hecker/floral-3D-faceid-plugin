// SPDX-License-Identifier: Apache-2.0
soong_namespace {
    imports: @NAMESPACE_IMPORTS@,
}

package {
    default_applicable_licenses: ["floral_faceid_license"],
}

license {
    name: "floral_faceid_license",
    visibility: ["//visibility:public"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0", "legacy_by_exception_only"],
    license_text: ["LICENSE", "NOTICE"],
}

cc_prebuilt_binary {
    name: "FloralFaceIDHal",
    owner: "google",
    stem: "android.hardware.biometrics.face@1.0-service.google",
    overrides: ["android.hardware.biometrics.face@1.0-service.google"],
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/bin/hw/android.hardware.biometrics.face@1.0-service.google",
            ],
            shared_libs: [
                "FloralFaceIDAirbrushClient",
                "FloralFaceIDV33Base",
                "libbinder_ndk",
                "FloralFaceIDCalibrationProto",
                "FloralFaceIDEnrollmentProto",
                "FloralFaceIDAuthUtil",
                "libhidlbase",
                "libion",
                "libkeymaster4_1support",
                "liblog",
                "libnos",
                "libnos_citadeld_proxy",
                "libnos_client_citadel",
                "libpng",
                "libprotobuf-cpp-full-3.9.1-vendorcompat",
                "libutils",
                "android.frameworks.stats-V1-ndk",
                "android.hardware.biometrics.face@1.0",
                "android.hardware.keymaster@4.1",
                "android.hardware.thermal@2.0",
                "FloralFaceIDCameraNDK",
                "libbinder",
                "FloralFaceIDV33Foundation",
                "libcutils",
                "libcamera_metadata",
                "libmediandk",
                "libnativewindow",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    strip: {
        none: true,
    },
    prefer: true,
    relative_install_path: "hw",
    init_rc: ["configs/floral-faceid-face.rc"],
    soc_specific: true,
}

